# Operator overrides for tracesleuthd, loaded by the systemd unit from
# /etc/tracesleuth/tracesleuth.env. Every line is optional; the daemon has
# working defaults (built-in policy and catalog, hostname as the host label).

# Host label recorded on every investigation (defaults to the machine hostname).
#TRACESLEUTH_HOST=prod-db-01

# Reviewable policy and catalog on disk instead of the built-ins. Editing these
# changes enforcement with a restart — no recompile.
#TRACESLEUTH_POLICY=/etc/tracesleuth/policy.rego
#TRACESLEUTH_CATALOG=/etc/tracesleuth/catalog.json

# Bind the health/metrics endpoint elsewhere (default 127.0.0.1:9464). Expose it
# beyond localhost only behind your own auth/firewall.
#TRACESLEUTH_HTTP=127.0.0.1:9464
